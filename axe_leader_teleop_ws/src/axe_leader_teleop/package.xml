<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>axe_leader_teleop</name>
  <version>0.1.0</version>
  <description>AXE leader → ROS 2: standalone bi_axe_udp_ros2_bridge, kinova_teleop, axe_leader_base_teleop (base+grippers), dual-arm Xbox + base, MOVO home.</description>
  <maintainer email="useradmin@todo.todo">useradmin</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>kinova_msgs</depend>
  <depend>joy_linux</depend>
  <depend>launch_ros</depend>
  <depend>launch</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
